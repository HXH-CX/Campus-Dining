# 复制为 .env 后按本机情况填写
DEBUG=true

# MySQL（本机已装 8.0，默认端口 3306）
DATABASE_URL=mysql+asyncmy://root:你的密码@127.0.0.1:3306/campus_foodie
DB_ECHO=false

# JWT
JWT_SECRET=please-change-this-to-a-random-32-byte-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# 上传
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5

# CORS（Vite 默认端口）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
